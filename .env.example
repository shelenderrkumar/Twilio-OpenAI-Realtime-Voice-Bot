# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-...

# logistics (courier support, English/Urdu) or grocery (voice shopping)
AGENT_PROFILE=logistics
REALTIME_MODEL=gpt-4o-realtime-preview
VOICE=alloy
PORT=5050

# Public hostname Twilio streams audio to, e.g. abcd1234.ngrok-free.app
PUBLIC_HOST=
# Set to verify X-Twilio-Signature on incoming webhooks
TWILIO_AUTH_TOKEN=

# Optional integrations
TRACKING_API_URL=
TAVILY_API_KEY=
SUPPORT_EMAIL=support@example.com
COMPLAINT_SENDER=voicebot@example.com
